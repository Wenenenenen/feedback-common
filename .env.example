# ============================================================
# vod-hls-server 环境变量配置样例
# 复制为 .env 后按需修改；所有变量均为可选项，不配置时使用默认值
# ============================================================

# HTTP 监听地址
VOD_ADDR=:8080

# 运行数据根目录（数据库、密钥、上传源文件、HLS 产物都在其下）
VOD_DATA_DIR=data

# 同时执行的 ffmpeg 转码任务数。机器配置弱或怕卡顿就保持 1，严格串行排队
VOD_WORKER_CONCURRENCY=1

# 单个上传文件大小上限（字节），默认 5368709120 = 5GB
VOD_MAX_UPLOAD_BYTES=5368709120

# HLS 分片目标时长（秒）
VOD_SEGMENT_SECONDS=6

# 签名默认有效期（秒），默认 7200 = 2 小时；
# m3u8 实际有效期还会与“视频时长+10 分钟”取较大值，保证长视频能完整看完
VOD_SIGN_TTL=7200

# HMAC 签名密钥（base64 编码，解码后至少 16 字节）。
# 不配置时首次启动自动生成 32 字节随机密钥并写入 data/secret.key；
# 多实例部署或想固定密钥时再配置此项。
# 生成方式（Go）：go run -  <<'EOF' ... 或用任意 base64 工具生成 32 字节随机数
# VOD_HMAC_KEY=

# ffmpeg / ffprobe 可执行文件路径。已在 PATH 中时无需配置；
# Windows 下若未加入 PATH，可写完整路径，例如 C:/ffmpeg/bin/ffmpeg.exe（用正斜杠）
VOD_FFMPEG_PATH=ffmpeg
VOD_FFPROBE_PATH=ffprobe
