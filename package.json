{
  "name": "clipcut-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "纯浏览器的口播视频粗剪工具",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-verify.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.65.2",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
